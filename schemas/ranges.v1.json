{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://public-ips.example/schemas/ranges.v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "display_name",
    "source_urls",
    "documentation_url",
    "normalized_data_sha256",
    "source_body_sha256",
    "first_observed_at",
    "provider",
    "categories"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "provider_id": {"type": "string"},
    "display_name": {"type": "string"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "documentation_url": {"type": "string", "format": "uri"},
    "normalized_data_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "first_observed_at": {"type": "string"},
    "provider": {"$ref": "#/$defs/rangeScope"},
    "categories": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/rangeScope"}
    }
  },
  "$defs": {
    "rangeScope": {
      "type": "object",
      "required": ["paths", "counts", "ipv4", "ipv6"],
      "properties": {
        "paths": {"type": "object"},
        "counts": {
          "type": "object",
          "required": ["ipv4", "ipv6"],
          "properties": {
            "ipv4": {"type": "integer", "minimum": 0},
            "ipv6": {"type": "integer", "minimum": 0}
          }
        },
        "ipv4": {"type": "array", "items": {"type": "string"}},
        "ipv6": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
